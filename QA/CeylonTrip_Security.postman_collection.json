{
  "info": {
    "name": "CeylonTrip Security Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "SEC-INJ-01 - Login Input Validation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":{\"$ne\":null},\"password\":{\"$ne\":null}}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid login input rejected', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "SEC-INJ-02 - Destination Search Validation",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/destinations?search=%28"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Special character handled safely', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "SEC-REG-01 - Normal Search Regression",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/destinations?search=Kandy"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Normal search works correctly', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.some(d => d.name === 'Kandy')).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
